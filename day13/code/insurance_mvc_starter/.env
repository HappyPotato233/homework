APP_NAME = "保险精准营销系统"
# DATABASE_URL 已改为在 config.py 中用 __file__ 推导项目根目录自动拼出，不再在此硬编码，
# 这样代码拷到任何机器都能正确定位 instance/starter.db。如需覆盖可取消下一行注释：
# DATABASE_URL = "sqlite:///instance/starter.db"
# JWT认证
JWT_SECRET_KEY = "your_jwt_secret_key"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES = 1440 # 24小时过期
JWT_ALGORITHM = "HS256" # 验证和签名JWT令牌的算法，默认使用HS256算法
LOG_LEVEL = "INFO"
